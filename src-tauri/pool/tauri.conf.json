{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wayrill Pool",
  "version": "0.1.12",
  "identifier": "app.wayrill.pool",
  "build": {
    "devUrl": "http://127.0.0.1:5173/pool.html",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wayrill Pool",
        "url": "pool.html",
        "width": 1120,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#10151d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["../icons/icon.ico"] }
}
