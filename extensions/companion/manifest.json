{
  "manifest_version": 3,
  "name": "Wayrill Companion",
  "description": "See the domains requested by the current page and their last known routes observed by Wayrill.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": ["webRequest", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Wayrill Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "128": "icon.png"
  },
  "key": ""
}
