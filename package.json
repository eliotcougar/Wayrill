{
  "name": "wayrill",
  "private": true,
  "version": "0.32.13",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "format": "prettier --write src vite.config.ts package.json vitest.config.ts vitest.core.config.ts oxlint.config.ts stylelint.config.js extensions/companion",
    "format:check": "prettier --check src vite.config.ts package.json vitest.config.ts vitest.core.config.ts oxlint.config.ts stylelint.config.js extensions/companion",
    "dev": "vite",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && npm run test:companion",
    "test:core": "pwsh -NoProfile -File tools/Check-Core.ps1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "prebuild": "node tools/Check-CoreDefaults.mjs",
    "pretest": "node tools/Check-CoreDefaults.mjs",
    "check:core-defaults": "node tools/Check-CoreDefaults.mjs",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "oxlint src extensions/companion vite.config.ts vitest.config.ts vitest.core.config.ts oxlint.config.ts --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" \"extensions/companion/*.css\" --max-warnings 0",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:css -- --fix",
    "check": "npm run check:core-defaults && npm run lint && npm run typecheck && npm run format:check && npm run check:companion",
    "check:companion": "node node_modules/@typescript/native/bin/tsc -p extensions/companion/tsconfig.json",
    "test:companion": "node --test extensions/companion/*.test.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@xyflow/react": "^12.12.0",
    "libavoid-js": "0.4.5",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@tauri-apps/cli": "^2.12.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
