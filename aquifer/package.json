{
  "name": "@wayrill/aquifer",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "npm run lint && tsc -b && npm run format:check",
    "lint": "eslint src vite.config.ts vitest.config.ts vitest.core.config.ts eslint.config.js --max-warnings 0",
    "format": "prettier --write src vite.config.ts package.json vitest.config.ts vitest.core.config.ts eslint.config.js",
    "format:check": "prettier --check src vite.config.ts package.json vitest.config.ts vitest.core.config.ts eslint.config.js",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:core": "pwsh -NoProfile -File ../tools/Check-AquiferCore.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@xyflow/react": "^12.12.0",
    "libavoid-js": "0.4.5",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@wayrill/core": "*",
    "@wayrill/ui": "*"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.24.9",
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "26.x"
  }
}
