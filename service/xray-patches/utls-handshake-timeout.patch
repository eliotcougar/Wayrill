@@ -0,0 +1,37 @@
+package tls
+
+import (
+	"context"
+	gotls "crypto/tls"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"testing/synctest"
+	"time"
+)
+
+func TestWayrillUTLSHandshakeDeadline(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		client, peer := net.Pipe()
+		defer client.Close()
+		defer peer.Close()
+
+		// The peer reads the ClientHello but never replies or closes first.
+		peerResult := make(chan error, 1)
+		go func() {
+			_, err := io.Copy(io.Discard, peer)
+			peerResult <- err
+		}()
+
+		conn := UClient(client, &gotls.Config{ServerName: "localhost"}, GetFingerprint("chrome")).(*UConn)
+		started := time.Now()
+		err := conn.HandshakeContext(context.Background())
+		if !errors.Is(err, context.DeadlineExceeded) || time.Since(started) != 30*time.Second {
+			t.Fatalf("handshake returned %v after %s, want a 30s deadline", err, time.Since(started))
+		}
+		if err := <-peerResult; err != nil {
+			t.Fatalf("peer did not receive EOF: %v", err)
+		}
+	})
+}
