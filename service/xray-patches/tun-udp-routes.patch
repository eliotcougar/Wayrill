diff --git a/common/session/wayrill_udp.go b/common/session/wayrill_udp.go
new file mode 100644
index 0000000..f1e0e5f
--- /dev/null
+++ b/common/session/wayrill_udp.go
@@ -0,0 +1,37 @@
+package session
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+)
+
+// The native attribution worker verifies the owning process before reporting
+// this identity. Endpoint is the kernel socket identity when available.
+type WayrillUDPOwner struct {
+	PID      uint32
+	Started  int64
+	Endpoint uint64
+}
+
+type WayrillUDPDispatch struct {
+	Peek   func([]byte, int, time.Duration) (int, error)
+	Settle func(context.Context, string, bool) bool
+}
+
+type wayrillUDPDispatchKey struct{}
+
+func WithWayrillUDPDispatch(ctx context.Context, dispatch *WayrillUDPDispatch) context.Context {
+	return context.WithValue(ctx, wayrillUDPDispatchKey{}, dispatch)
+}
+
+func WayrillUDPDispatchFromContext(ctx context.Context) *WayrillUDPDispatch {
+	dispatch, _ := ctx.Value(wayrillUDPDispatchKey{}).(*WayrillUDPDispatch)
+	return dispatch
+}
+
+var wayrillUDPEpoch atomic.Uint64
+
+func WayrillUDPEpoch() uint64 { return wayrillUDPEpoch.Load() }
+
+func AdvanceWayrillUDPEpoch() { wayrillUDPEpoch.Add(1) }
