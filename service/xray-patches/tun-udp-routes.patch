+// WayrillCanShareUDP reports whether the handler can preserve the destination
+// and reply source of each datagram across a single IP-addressed association.
+func (h *Handler) WayrillCanShareUDP() bool {
+	config, ok := h.proxyConfig.(*freedom.Config)
+	if !ok || h.mux != nil || config.DestinationOverride != nil || config.ProxyProtocol != 0 ||
+		len(config.Noises) != 0 || len(config.FinalRules) != 0 {
+		return false
+	}
+	stream := h.streamSettings
+	return stream == nil || (stream.FinalMask == nil && stream.SocketSettings.GetDialerProxy() == "")
+}
