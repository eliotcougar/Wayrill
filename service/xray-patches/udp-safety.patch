+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+func TestDetachedXUDPReaderCannotTakeTheReplacementReply(t *testing.T) {
+	down, reply := pipe.New()
+	manager := NewSessionManager()
+	x := &XUDP{}
+	old := &Session{input: down, output: buf.Discard, parent: manager, ID: 1, done: done.New(), XUDP: x}
+	if !manager.Add(old) {
+		t.Fatal("could not start association")
+	}
+	old.Close(false)
+	if err := reply.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes([]byte("next reply"))}); err != nil {
+		t.Fatal(err)
+	}
+	if packets, err := (xudpDownlink{down, old.done.Wait()}).ReadMultiBuffer(); err != io.EOF || len(packets) != 0 {
+		buf.ReleaseMulti(packets)
+		t.Fatalf("detached reader could still read: %v", err)
+	}
+	packets, err := down.ReadMultiBufferTimeout(time.Second)
+	defer buf.ReleaseMulti(packets)
+	if err != nil || packets.String() != "next reply" {
+		t.Fatalf("replacement reader lost its reply: %v", err)
+	}
+}
+
+func TestExpiredXUDPStartsWithFreshPipes(t *testing.T) {
+	down, _ := pipe.New()
+	up, write := pipe.New()
+	manager := NewSessionManager()
+	key := xudpKey{id: [8]byte{44}}
+	x, _ := beginXUDP(key, time.Now())
+	t.Cleanup(func() {
+		XUDPManager.Lock()
+		delete(XUDPManager.Map, key)
+		XUDPManager.Unlock()
+	})
+	old := &Session{input: down, output: write, parent: manager, ID: 1, done: done.New(), XUDP: x}
+	if !manager.Add(old) {
+		t.Fatal("could not start association")
+	}
+	old.Close(false)
+	XUDPManager.Lock()
+	expires := x.Expire
+	XUDPManager.Unlock()
+	fresh, previous := beginXUDP(key, expires)
+	if fresh == nil || fresh == x || previous != nil {
+		t.Fatal("an expired association was still eligible for resumption")
+	}
+	if _, err := up.ReadMultiBufferTimeout(time.Second); err != io.EOF {
+		t.Fatalf("expired association retained its old pipes: %v", err)
+	}
+}
+
+type xudpTestDispatcher struct {
+	routing.Dispatcher
+	uplinks []*pipe.Reader
+}
+
+func (d *xudpTestDispatcher) Dispatch(context.Context, net.Destination) (*transport.Link, error) {
+	up, write := pipe.New()
+	down, _ := pipe.New()
+	d.uplinks = append(d.uplinks, up)
+	return &transport.Link{Reader: down, Writer: write}, nil
+}
+
+func TestXUDPResumeIsScopedToTargetAndUser(t *testing.T) {
+	id := [8]byte{72, 101, 230, 33}
+	defer func() {
+		XUDPManager.Lock()
+		defer XUDPManager.Unlock()
+		for key, x := range XUDPManager.Map {
+			if key.id == id {
+				x.Interrupt()
+				delete(XUDPManager.Map, key)
+			}
+		}
+	}()
+	server := new(xudpTestDispatcher)
+	a := net.UDPDestination(net.ParseAddress("198.51.100.8"), 3478)
+	b := net.UDPDestination(net.ParseAddress("198.51.100.9"), 5000)
+	first, second := &protocol.MemoryUser{}, &protocol.MemoryUser{}
+	for index, test := range []struct {
+		target net.Destination
+		user   *protocol.MemoryUser
+		route  int
+	}{
+		{a, first, 1},  // First dispatch.
+		{a, first, 1},  // Same authenticated association resumes.
+		{b, first, 2},  // Same ID cannot reuse a different target's route.
+		{b, second, 3}, // Same ID and target cannot reuse another user's route.
+	} {
+		worker := &ServerWorker{dispatcher: server, link: &transport.Link{Writer: buf.Discard}, sessionManager: NewSessionManager()}
+		frame := &buf.MultiBufferContainer{MultiBuffer: buf.MultiBuffer{buf.FromBytes([]byte{0, 1, byte(index)})}}
+		meta := &FrameMetadata{Target: test.target, GlobalID: id, SessionID: 1, Option: OptionData}
+		ctx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: "test", User: test.user})
+		if err := worker.handleStatusNew(ctx, meta, &buf.BufferedReader{Reader: frame}); err != nil {
+			t.Fatal(err)
+		}
+		if len(server.uplinks) != test.route {
+			t.Fatalf("packet %d used the wrong dispatch, got %d, want %d", index, len(server.uplinks), test.route)
+		}
+		packets, err := server.uplinks[test.route-1].ReadMultiBufferTimeout(time.Second)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ok := len(packets) == 1 && packets[0].UDP != nil && *packets[0].UDP == test.target && packets[0].Byte(0) == byte(index)
+		buf.ReleaseMulti(packets)
+		if !ok {
+			t.Fatalf("packet %d lost its target or payload", index)
+		}
+	}
+}
