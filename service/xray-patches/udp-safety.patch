+
+func TestFreedomPreservesLargeUDPDatagrams(t *testing.T) {
+	local := &stdnet.UDPAddr{IP: stdnet.IPv4(127, 0, 0, 1)}
+	receiver, err := stdnet.ListenUDP("udp4", local)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer receiver.Close()
+	sender, err := stdnet.ListenUDP("udp4", local)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sender.Close()
+	if err := receiver.SetReadDeadline(time.Now().Add(3 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	peer := sender.LocalAddr()
+	destination := net.DestinationFromAddr(peer)
+	reader := NewPacketReader(&net.PacketConnWrapper{PacketConn: receiver, Dest: peer}, &Handler{}, nil, net.Destination{}, destination).(*PacketReader)
+	reader.fullDatagrams = true
+	for _, size := range []int{buf.Size + 1, 65507, 32} {
+		payload := bytes.Repeat([]byte{0xa5}, size)
+		if _, err := sender.WriteToUDP(payload, receiver.LocalAddr().(*stdnet.UDPAddr)); err != nil {
+			t.Fatal(err)
+		}
+		packets, err := reader.ReadMultiBuffer()
+		if err != nil {
+			t.Fatalf("reading %d-byte datagram: %v", size, err)
+		}
+		ok := len(packets) == 1 && packets[0].UDP != nil && *packets[0].UDP == destination && bytes.Equal(packets[0].Bytes(), payload)
+		buf.ReleaseMulti(packets)
+		if !ok {
+			t.Fatalf("lost payload or source of %d-byte datagram", size)
+		}
