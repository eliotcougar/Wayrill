+//go:build !windows
+
+package internet
+
+import (
+	"context"
+	"net"
+
+	xnet "github.com/xtls/xray-core/common/net"
+)
+
+func guardsDirectIPv6(context.Context) bool { return false }
+
+func guardDirectIPv6TCP(context.Context, xnet.Address, *SocketConfig, string, string) error {
+	return nil
+}
+
+func guardDirectIPv6Packets(_ context.Context, _ xnet.Address, _ *SocketConfig, conn net.PacketConn) net.PacketConn {
+	return conn
+}
