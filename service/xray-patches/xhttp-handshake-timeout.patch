+package splithttp
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"errors"
+	"io"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/reality"
+	"github.com/xtls/xray-core/transport/internet/tls"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestXHTTPStalledHandshake(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, security := range map[string]proto.Message{
+		"TLS":     &tls.Config{Fingerprint: "unsafe", NextProtocol: []string{"h2"}},
+		"uTLS":    &tls.Config{Fingerprint: "chrome", NextProtocol: []string{"h2"}},
+		"REALITY": &reality.Config{Fingerprint: "chrome", ServerName: "localhost", PublicKey: key.PublicKey().Bytes()},
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.LocalHostIP.IP()})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { listener.Close() })
+			ctx, cancel := context.WithTimeout(t.Context(), 15*time.Second)
+			defer cancel()
+			deadline, _ := ctx.Deadline()
+			peerClosed := make(chan error, 1)
+			go func() {
+				conn, err := listener.AcceptTCP()
+				if err != nil {
+					peerClosed <- err
+					return
+				}
+				defer conn.Close()
+				if err := conn.SetReadDeadline(deadline); err != nil {
+					peerClosed <- err
+					return
+				}
+				// Read the ClientHello and keep TCP open without answering it.
+				_, err = io.Copy(io.Discard, conn)
+				peerClosed <- err
+			}()
+
+			dest := net.TCPDestination(net.LocalHostIP, net.Port(listener.Addr().(*net.TCPAddr).Port))
+			client := createHTTPClient(dest, &internet.MemoryStreamConfig{
+				ProtocolSettings: &Config{},
+				SecurityType:     serial.GetMessageType(security),
+				SecuritySettings: security,
+			}).(*DefaultDialerClient).client
+			req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://localhost/", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if resp, err := client.Do(req); err == nil {
+				resp.Body.Close()
+				t.Fatal("HTTP request succeeded against the silent peer")
+			} else if !errors.Is(err, context.DeadlineExceeded) || ctx.Err() != nil {
+				t.Fatalf("handshake should time out before the request context, got %v (request: %v)", err, ctx.Err())
+			}
+			if err := <-peerClosed; err != nil {
+				t.Fatalf("peer did not receive EOF after handshake timeout: %v", err)
+			}
+		})
+	}
+}
