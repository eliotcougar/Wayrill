@@ -0,0 +1,48 @@
+package socks
+
+import (
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+)
+
+func TestWayrillRelayAuthentication(t *testing.T) {
+	const username, secret, id = "wtr-p-a", "wayrill-relay/example-secret", "flow-1"
+	user := &protocol.MemoryUser{Account: &Account{Username: username, Password: secret}}
+	ctx := session.ContextWithWayrillRelayID(context.Background(), id)
+	local := net.ParseAddress("127.0.0.1")
+	remote := net.ParseAddress("192.0.2.1")
+	config := &ServerConfig{Accounts: map[string]string{username: secret, "regular": secret}}
+
+	if got := wayrillRelayUser(ctx, remote, user); got != user {
+		t.Fatal("annotated non-loopback credentials")
+	}
+	annotated := wayrillRelayUser(ctx, local, user).Account.(*Account).Password
+	if annotated != secret+"/"+id || user.Account.(*Account).Password != secret {
+		t.Fatal("failed to annotate a private copy of the credentials")
+	}
+	for _, tc := range []struct {
+		name, username, password string
+		address                  net.Address
+		allowed                  bool
+	}{
+		{"private relay", username, annotated, local, true},
+		{"wrong secret", username, "wayrill-relay/wrong/" + id, local, false},
+		{"invalid id", username, secret + "/invalid/id", local, false},
+		{"non-private account", "regular", annotated, local, false},
+		{"non-loopback listener", username, annotated, remote, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := &ServerSession{config: config, localAddress: tc.address}
+			if got := s.authenticateWayrillRelay(tc.username, tc.password); got != tc.allowed {
+				t.Fatalf("authentication = %t, want %t", got, tc.allowed)
+			}
+			if (s.wayrillRelayID == id) != tc.allowed {
+				t.Fatal("incorrect authenticated flow ID")
+			}
+		})
+	}
+}
