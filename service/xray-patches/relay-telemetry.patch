new file mode 100644
index 0000000..f7d6083
--- /dev/null
+++ b/common/session/wayrill_relay.go
@@ -0,0 +1,30 @@
+package session
+
+import (
+	"context"
+	"crypto/rand"
+	"strconv"
+	"sync"
+	"sync/atomic"
+)
+
+// Only the app's private policy-group relays opt in to flow telemetry.
+const WayrillRelayTagPrefix = "wtr-p-"
+
+type wayrillRelayKey struct{}
+
+var newWayrillRelayID = sync.OnceValue(rand.Text)
+var wayrillRelaySequence atomic.Uint64
+
+func NewWayrillRelayID() string {
+	return newWayrillRelayID() + "-" + strconv.FormatUint(wayrillRelaySequence.Add(1), 36)
+}
+
+func ContextWithWayrillRelayID(ctx context.Context, id string) context.Context {
+	return context.WithValue(ctx, wayrillRelayKey{}, id)
+}
+
+func WayrillRelayIDFromContext(ctx context.Context) string {
+	id, _ := ctx.Value(wayrillRelayKey{}).(string)
+	return id
+}
