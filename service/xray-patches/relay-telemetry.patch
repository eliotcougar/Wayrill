diff --git a/proxy/socks/wayrill_relay.go b/proxy/socks/wayrill_relay.go
new file mode 100644
index 0000000..f1c1b8c
--- /dev/null
+++ b/proxy/socks/wayrill_relay.go
@@ -0,0 +1,51 @@
+package socks
+
+import (
+	"context"
+	"strings"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+)
+
+const wayrillRelayPasswordPrefix = "wayrill-relay/"
+
+func wayrillRelayUser(ctx context.Context, address net.Address, user *protocol.MemoryUser) *protocol.MemoryUser {
+	id := session.WayrillRelayIDFromContext(ctx)
+	account, ok := user.Account.(*Account)
+	if id == "" || !ok || !address.Family().IsIP() || !address.IP().IsLoopback() ||
+		!strings.HasPrefix(account.Username, session.WayrillRelayTagPrefix) ||
+		!strings.HasPrefix(account.Password, wayrillRelayPasswordPrefix) {
+		return user
+	}
+	// Keep the shared outbound credentials immutable.
+	copy := *user
+	copy.Account = &Account{Username: account.Username, Password: account.Password + "/" + id}
+	return &copy
+}
+
+func (s *ServerSession) authenticateWayrillRelay(username, password string) bool {
+	if !strings.HasPrefix(username, session.WayrillRelayTagPrefix) ||
+		!s.localAddress.Family().IsIP() || !s.localAddress.IP().IsLoopback() {
+		return false
+	}
+	secret, ok := strings.CutPrefix(password, wayrillRelayPasswordPrefix)
+	if !ok {
+		return false
+	}
+	secret, id, ok := strings.Cut(secret, "/")
+	if !ok || len(id) == 0 || len(id) > 64 {
+		return false
+	}
+	for _, c := range id {
+		if !(c >= '0' && c <= '9' || c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '-') {
+			return false
+		}
+	}
+	if !s.config.HasAccount(username, wayrillRelayPasswordPrefix+secret) {
+		return false
+	}
+	s.wayrillRelayID = id
+	return true
+}
