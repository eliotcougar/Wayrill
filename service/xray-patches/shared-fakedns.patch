+func TestWayrillFakeDNSMetrics(t *testing.T) {
+	config := metricsTestConfig(&Config{Tag: "metrics_out"})
+	config.App = append(config.App, serial.ToTypedMessage(&fakedns.FakeDnsPoolMulti{Pools: []*fakedns.FakeDnsPool{{IpPool: "198.18.0.0/28", LruSize: 3}}}))
+	server, err := core.New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = server.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { server.Close() })
+	check := func(used float64) {
+		t.Helper()
+		response := httptest.NewRecorder()
+		metricsHandler(t, server).httpHandler().ServeHTTP(response, httptest.NewRequest("GET", "/debug/vars", nil))
+		var payload map[string]json.RawMessage
+		if err := json.Unmarshal(response.Body.Bytes(), &payload); err != nil {
+			t.Fatal(err)
+		}
+		var pools []map[string]any
+		if err := json.Unmarshal(payload["fakeDns"], &pools); err != nil {
+			t.Fatal(err)
+		}
+		if len(pools) != 1 || pools[0]["capacity"] != float64(3) {
+			t.Fatalf("bad telemetry: %s", payload["fakeDns"])
+		}
+		got, present := pools[0]["used"].(float64)
+		if !present || got != used {
+			t.Fatalf("used=%v, want %v", got, used)
+		}
+	}
+	check(0)
+	engine := server.GetFeature((*dns.FakeDNSEngine)(nil)).(dns.FakeDNSEngine)
+	engine.GetFakeIPForDomain("example.org")
+	check(1)
