+package fakedns
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWayrillResolverCancellationReleasesUnreadClient(t *testing.T) {
+	t.Setenv("WAYRILL_FAKEDNS", "127.0.0.1:1:"+strings.Repeat("a", 64))
+	reader, writer := pipe.New()
+	outReader, outWriter := pipe.New()
+	defer common.Interrupt(reader)
+	defer common.Interrupt(writer)
+	defer common.Interrupt(outReader)
+	defer common.Interrupt(outWriter)
+	ctx, cancel := context.WithCancel(session.ContextWithInbound(context.Background(), &session.Inbound{Tag: "wr-tun-resolver-native-test", Source: xnet.TCPDestination(xnet.LocalHostIP, 1234)}))
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := WayrillHandleResolver(ctx, &transport.Link{Reader: reader, Writer: outWriter}, resolverTestClient{})
+		done <- err
+	}()
+	// No request bytes arrive. Parent cancellation must interrupt the blocked read,
+	// not wait for the independent eight-second timeout.
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cancelled resolver retained its blocked input")
+	}
+}
