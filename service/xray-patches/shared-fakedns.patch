+package fakedns
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/dns/fakedns/command"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/dns"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func TestWayrillEndedMappingLifetimeRejectsNewRequests(t *testing.T) {
+	address, secret := sharedTestPool(t)
+	client := sharedTestClient(t, address, secret).(*wayrillRemote)
+	client.cancel()
+	var invoked atomic.Uint64
+	var workers sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		workers.Go(func() {
+			for j := 0; j < 128; j++ {
+				err := client.call(context.Background(), "cancelled", func(context.Context, command.FakeDNSServiceClient) error {
+					invoked.Add(1)
+					return nil
+				})
+				if !errors.Is(err, context.Canceled) {
+					t.Errorf("mapping after lifetime cancellation: %v", err)
+					return
+				}
+			}
+		})
+	}
+	workers.Wait()
+	if invoked.Load() != 0 || len(client.slots) != 0 || client.failures.Load() != 0 {
+		t.Fatal("ended lifetime admitted new mapping work or reported an authority failure")
+	}
+}
+
+func TestWayrillMappingRequestCancellation(t *testing.T) {
+	l, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := grpc.NewServer()
+	defer server.Stop()
+	source := &waitingFakeService{started: make(chan struct{}, 32)}
+	command.RegisterFakeDNSServiceServer(server, source)
+	go server.Serve(l)
+	client := sharedTestClient(t, l.Addr().String(), strings.Repeat("a", 64)).(*wayrillRemote)
+	var engine dns.FakeDNSEngineContext = client
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := engine.ReverseLookup(ctx, net.ParseAddress("198.18.0.1")); done <- err }()
+	select {
+	case <-source.started:
+	case <-time.After(time.Second):
+		t.Fatal("request did not reach authority")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if status.Code(err) != codes.Canceled {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("mapping call lost cancellation")
+	}
+	if len(client.slots) != 0 || client.failures.Load() != 0 || client.reported.Load() != 0 {
+		t.Fatal("canceled request leaked admission or reported an authority failure")
+	}
+	// Already-canceled callers must not wait behind the bounded admission queue.
+	for i := 0; i < cap(client.slots); i++ {
+		client.slots <- struct{}{}
+	}
+	_, err = engine.ReverseLookup(ctx, net.ParseAddress("198.18.0.1"))
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	for len(client.slots) > 0 {
+		<-client.slots
+	}
+}
diff --git a/app/dns/fakedns/wayrill_resolver.go b/app/dns/fakedns/wayrill_resolver.go
new file mode 100644
index 00000000..f0d11529
--- /dev/null
+++ b/app/dns/fakedns/wayrill_resolver.go
@@ -0,0 +1,177 @@
+package fakedns
+
+// The private resolver bridge preserves native DNS lookup options. Ordinary DNS
+// wire messages cannot distinguish client FakeDNS answers from a real-IP lookup
+// made by Freedom, routing, or a proxy transport.
+import (
+	"bufio"
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"fmt"
+	stdnet "net"
+	"net/netip"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	errutil "github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/transport"
+)
+
+type wayrillLookup struct {
+	Auth   string       `json:"auth"`
+	Domain string       `json:"domain"`
+	Option dns.IPOption `json:"option"`
+}
+type wayrillAnswer struct {
+	IPs    []string `json:"ips,omitempty"`
+	TTL    uint32   `json:"ttl"`
+	RCode  uint16   `json:"rcode,omitempty"`
+	Empty  bool     `json:"empty,omitempty"`
+	Failed bool     `json:"failed,omitempty"`
+}
+type WayrillResolver struct {
+	address, secret string
+	slots           chan struct{}
+}
+
+func NewWayrillResolver(u *url.URL) (*WayrillResolver, error) {
+	_, secret, err := wayrillEndpoint(os.Getenv("WAYRILL_FAKEDNS"))
+	if err != nil {
+		return nil, err
+	}
+	a, err := netip.ParseAddrPort(u.Host)
+	if err != nil || a.Addr() != netip.MustParseAddr("127.0.0.1") || a.Port() == 0 || u.Path != "" || u.RawQuery != "" || u.Fragment != "" || u.User != nil {
+		return nil, fmt.Errorf("invalid private resolver endpoint")
+	}
+	return &WayrillResolver{a.String(), secret, make(chan struct{}, 32)}, nil
+}
+func (*WayrillResolver) Name() string         { return "Wayrill native resolver" }
+func (*WayrillResolver) IsDisableCache() bool { return true }
+func (r *WayrillResolver) QueryIP(ctx context.Context, domain string, option dns.IPOption) ([]net.IP, uint32, error) {
+	if !wayrillDomain(domain) {
+		return nil, 0, fmt.Errorf("invalid resolver domain")
+	}
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	select {
+	case r.slots <- struct{}{}:
+		defer func() { <-r.slots }()
+	case <-ctx.Done():
+		return nil, 0, ctx.Err()
+	}
+	c, err := (&stdnet.Dialer{}).DialContext(ctx, "tcp4", r.address)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer c.Close()
+	stop := context.AfterFunc(ctx, func() { c.Close() })
+	defer stop()
+	deadline, _ := ctx.Deadline()
+	if err = c.SetDeadline(deadline); err != nil {
+		return nil, 0, err
+	}
+	if err = json.NewEncoder(c).Encode(wayrillLookup{r.secret, domain, option}); err != nil {
+		return nil, 0, err
+	}
+	data, err := bufio.NewReaderSize(c, wayrillFrame).ReadSlice('\n')
+	if err != nil {
+		return nil, 0, err
+	}
+	var answer wayrillAnswer
+	if err = wayrillDecode(data, &answer); err != nil {
+		return nil, 0, err
+	}
+	if answer.RCode != 0 {
+		return nil, answer.TTL, dns.RCodeError(answer.RCode)
+	}
+	if answer.Empty {
+		return nil, answer.TTL, dns.ErrEmptyResponse
+	}
+	if answer.Failed {
+		return nil, 0, fmt.Errorf("native resolver query failed")
+	}
+	ips := make([]net.IP, 0, len(answer.IPs))
+	for _, s := range answer.IPs {
+		ip, err := netip.ParseAddr(s)
+		if err != nil || ip.Zone() != "" || ip.Is4() && !option.IPv4Enable || ip.Is6() && !option.IPv6Enable {
+			return nil, 0, fmt.Errorf("invalid native resolver response")
+		}
+		ips = append(ips, ip.AsSlice())
+	}
+	return ips, answer.TTL, nil
+}
+
+type wayrillContextClient interface {
+	LookupIPContext(context.Context, string, dns.IPOption) ([]net.IP, uint32, error)
+}
+
+var wayrillResolverSlots = make(chan struct{}, 32)
+
+func WayrillHandleResolver(ctx context.Context, link *transport.Link, client dns.Client) (bool, error) {
+	inbound := session.InboundFromContext(ctx)
+	if os.Getenv("WAYRILL_FAKEDNS") == "" || inbound == nil || !strings.HasPrefix(inbound.Tag, "wr-tun-resolver-native-") {
+		return false, nil
+	}
+	// This handler is reachable only through the service-generated loopback
+	// inbound. Authentication remains mandatory, even for a local caller.
+	if !inbound.Source.IsValid() || !inbound.Source.Address.Family().IsIP() || !inbound.Source.Address.IP().IsLoopback() {
+		return true, fmt.Errorf("private resolver is loopback only")
+	}
+	_, secret, err := wayrillEndpoint(os.Getenv("WAYRILL_FAKEDNS"))
+	if err != nil {
+		return true, err
+	}
+	select {
+	case wayrillResolverSlots <- struct{}{}:
+		defer func() { <-wayrillResolverSlots }()
+	default:
+		return true, fmt.Errorf("native resolver capacity exceeded")
+	}
+	native, ok := client.(wayrillContextClient)
+	if !ok {
+		return true, fmt.Errorf("private resolver requires cancellable native DNS")
+	}
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	stop := context.AfterFunc(ctx, func() { common.Interrupt(link.Reader); common.Interrupt(link.Writer) })
+	defer stop()
+	reader := &buf.BufferedReader{Reader: link.Reader}
+	defer reader.Close()
+	data, err := bufio.NewReaderSize(reader, 2048).ReadSlice('\n')
+	if err != nil {
+		return true, err
+	}
+	var request wayrillLookup
+	if wayrillDecode(data, &request) != nil || subtle.ConstantTimeCompare([]byte(request.Auth), []byte(secret)) != 1 || !wayrillDomain(request.Domain) || !request.Option.IPv4Enable && !request.Option.IPv6Enable {
+		return true, fmt.Errorf("invalid private resolver request")
+	}
+	ips, ttl, queryErr := native.LookupIPContext(ctx, request.Domain, request.Option)
+	if ctx.Err() != nil {
+		return true, ctx.Err()
+	}
+	answer := wayrillAnswer{TTL: ttl, RCode: dns.RCodeFromError(queryErr)}
+	if queryErr != nil && answer.RCode == 0 {
+		answer.Empty = errutil.Cause(queryErr) == dns.ErrEmptyResponse
+		answer.Failed = !answer.Empty
+	}
+	for _, ip := range ips {
+		answer.IPs = append(answer.IPs, ip.String())
+	}
+	data, err = json.Marshal(answer)
+	if err != nil || len(data) >= wayrillFrame {
+		return true, fmt.Errorf("invalid private resolver response size")
+	}
+	writer := buf.NewBufferedWriter(link.Writer)
+	if _, err = writer.Write(append(data, '\n')); err != nil {
+		return true, err
+	}
+	return true, writer.Flush()
+}
diff --git a/app/dns/fakedns/wayrill_resolver_test.go b/app/dns/fakedns/wayrill_resolver_test.go
new file mode 100644
index 00000000..d9b701a9
--- /dev/null
+++ b/app/dns/fakedns/wayrill_resolver_test.go
@@ -0,0 +1,98 @@
+package fakedns
+
+import (
+	"context"
+	"net"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/transport"
+)
+
+type resolverTestClient struct{}
+
+func (resolverTestClient) Type() interface{} { return dns.ClientType() }
+func (resolverTestClient) Start() error      { return nil }
+func (resolverTestClient) Close() error      { return nil }
+func (resolverTestClient) LookupIP(domain string, option dns.IPOption) ([]net.IP, uint32, error) {
+	if domain == "empty.example" {
+		return nil, 7, dns.ErrEmptyResponse
+	}
+	if domain == "rcode.example" {
+		return nil, 0, dns.RCodeError(3)
+	}
+	ip := "192.0.2.1"
+	if option.FakeEnable {
+		ip = "198.18.0.1"
+	}
+	if option.IPv6Enable && !option.IPv4Enable {
+		ip = "2001:db8::1"
+		if option.FakeEnable {
+			ip = "2001:2::1"
+		}
+	}
+	return []net.IP{net.ParseIP(ip)}, 123, nil
+}
+func (c resolverTestClient) LookupIPContext(ctx context.Context, domain string, option dns.IPOption) ([]net.IP, uint32, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, 0, err
+	}
+	return c.LookupIP(domain, option)
+}
+func TestWayrillResolverPreservesNativeLookupOptions(t *testing.T) {
+	t.Setenv("WAYRILL_FAKEDNS", "127.0.0.1:1:"+strings.Repeat("a", 64))
+	l, e := net.Listen("tcp4", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	var pending sync.WaitGroup
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			c, e := l.Accept()
+			if e != nil {
+				return
+			}
+			pending.Add(1)
+			go func() {
+				defer pending.Done()
+				defer c.Close()
+				ctx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: "wr-tun-resolver-native-test", Source: xnet.TCPDestination(xnet.LocalHostIP, 1234)})
+				handled, err := WayrillHandleResolver(ctx, &transport.Link{Reader: buf.NewReader(c), Writer: buf.NewWriter(c)}, resolverTestClient{})
+				if !handled || err != nil {
+					t.Errorf("resolver: handled=%v err=%v", handled, err)
+				}
+			}()
+		}
+	}()
+	t.Cleanup(func() { l.Close(); <-done; pending.Wait() })
+	u, _ := url.Parse("wayrill-dns://" + l.Addr().String())
+	client, e := NewWayrillResolver(u)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, test := range []struct {
+		option dns.IPOption
+		want   string
+	}{{dns.IPOption{IPv4Enable: true}, "192.0.2.1"}, {dns.IPOption{IPv4Enable: true, FakeEnable: true}, "198.18.0.1"}, {dns.IPOption{IPv6Enable: true}, "2001:db8::1"}, {dns.IPOption{IPv6Enable: true, FakeEnable: true}, "2001:2::1"}} {
+		ips, ttl, e := client.QueryIP(context.Background(), "one.example", test.option)
+		if e != nil || len(ips) != 1 || ips[0].String() != test.want || ttl != 123 {
+			t.Fatalf("options %+v: %v ttl=%d err=%v", test.option, ips, ttl, e)
+		}
+	}
+	_, ttl, e := client.QueryIP(context.Background(), "empty.example", dns.IPOption{IPv4Enable: true})
+	if e != dns.ErrEmptyResponse || ttl != 7 {
+		t.Fatal("empty response was lost", ttl, e)
+	}
+	_, _, e = client.QueryIP(context.Background(), "rcode.example", dns.IPOption{IPv4Enable: true})
+	if dns.RCodeFromError(e) != 3 {
+		t.Fatal("DNS response code was lost", e)
+	}
+}
diff --git a/app/dns/fakedns/wayrill_shared.go b/app/dns/fakedns/wayrill_shared.go
new file mode 100644
index 00000000..86aa3eb4
--- /dev/null
+++ b/app/dns/fakedns/wayrill_shared.go
@@ -0,0 +1,376 @@
+package fakedns
+
+// Private Wayrill integration. The protobuf contract is shared with the general
+// FakeDNS API proposal; authentication and endpoint injection belong to the app.
+import (
+	"bytes"
+	"context"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	stdnet "net"
+	"net/netip"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/app/dns/fakedns/command"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/dns"
+	"golang.org/x/net/netutil"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/keepalive"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/peer"
+	"google.golang.org/grpc/status"
+)
+
+const wayrillFrame = 32768
+const wayrillDeadline = 1800 * time.Millisecond
+const wayrillAuthHeader = "x-wayrill-auth"
+
+func wayrillEndpoint(value string) (string, string, error) {
+	fields := strings.Split(value, ":")
+	if len(fields) != 3 || fields[0] != "127.0.0.1" || len(fields[2]) != 64 {
+		return "", "", fmt.Errorf("invalid shared FakeDNS endpoint")
+	}
+	if _, err := hex.DecodeString(fields[2]); err != nil {
+		return "", "", fmt.Errorf("invalid shared FakeDNS credential")
+	}
+	address := fields[0] + ":" + fields[1]
+	parsed, err := netip.ParseAddrPort(address)
+	if err != nil || parsed.Port() == 0 {
+		return "", "", fmt.Errorf("invalid shared FakeDNS address")
+	}
+	return address, fields[2], nil
+}
+
+func wayrillDomain(domain string) bool {
+	return len(domain) > 0 && len(domain) <= 253 && !strings.ContainsAny(domain, "\x00\r\n\t ")
+}
+
+// The native resolver bridge has a different contract (IPOption, TTL and RCode)
+// and remains separate from the allocator RPCs.
+func wayrillDecode(data []byte, value any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(value); err != nil {
+		return err
+	}
+	if decoder.Decode(new(any)) != io.EOF {
+		return fmt.Errorf("trailing private DNS data")
+	}
+	return nil
+}
+
+type wayrillCredential string
+
+func (c wayrillCredential) GetRequestMetadata(context.Context, ...string) (map[string]string, error) {
+	return map[string]string{wayrillAuthHeader: string(c)}, nil
+}
+
+// The dialer below accepts only a literal loopback endpoint, bypassing proxies.
+func (wayrillCredential) RequireTransportSecurity() bool { return false }
+
+type wayrillRemote struct {
+	dns.FakeDNSEngineRev0
+	ctx             context.Context
+	cancel          context.CancelFunc
+	address, secret string
+	lifecycle       sync.Mutex
+	conn            *grpc.ClientConn
+	client          atomic.Pointer[wayrillRPCClient]
+	slots           chan struct{}
+	failures        atomic.Uint64
+	reported        atomic.Int64
+}
+type wayrillRPCClient struct{ command.FakeDNSServiceClient }
+
+func wayrillShared(ctx context.Context, local dns.FakeDNSEngineRev0) (dns.FakeDNSEngineRev0, error) {
+	value := os.Getenv("WAYRILL_FAKEDNS")
+	if value == "" {
+		return local, nil
+	}
+	address, secret, err := wayrillEndpoint(value)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	return &wayrillRemote{FakeDNSEngineRev0: local, ctx: ctx, cancel: cancel,
+		address: address, secret: secret, slots: make(chan struct{}, 32)}, nil
+}
+
+func (r *wayrillRemote) Start() error {
+	r.lifecycle.Lock()
+	defer r.lifecycle.Unlock()
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	if r.conn != nil {
+		return nil
+	}
+	if err := r.FakeDNSEngineRev0.Start(); err != nil {
+		return err
+	}
+	conn, err := grpc.NewClient("passthrough:///wayrill-fakedns",
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithPerRPCCredentials(wayrillCredential(r.secret)),
+		grpc.WithContextDialer(func(ctx context.Context, _ string) (stdnet.Conn, error) {
+			return (&stdnet.Dialer{}).DialContext(ctx, "tcp4", r.address)
+		}),
+		grpc.WithDefaultCallOptions(grpc.MaxCallSendMsgSize(2048), grpc.MaxCallRecvMsgSize(wayrillFrame)))
+	if err != nil {
+		return err
+	}
+	defer func() {
+		if r.conn == nil {
+			conn.Close()
+		}
+	}()
+	client := command.NewFakeDNSServiceClient(conn)
+	ctx, cancel := context.WithTimeout(r.ctx, wayrillDeadline)
+	defer cancel()
+	response, err := client.GetPools(ctx, &command.GetPoolsRequest{})
+	if err != nil {
+		return fmt.Errorf("shared FakeDNS readiness: %w", err)
+	}
+	// Every consumer must agree with the authority's geometry before dispatch.
+	want := wayrillPools(r.FakeDNSEngineRev0)
+	if len(want) != len(response.IpPools) {
+		return fmt.Errorf("shared FakeDNS pools differ from runtime configuration")
+	}
+	for i, prefix := range want {
+		if prefix != response.IpPools[i] {
+			return fmt.Errorf("shared FakeDNS pools differ from runtime configuration")
+		}
+	}
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	r.conn = conn
+	r.client.Store(&wayrillRPCClient{client})
+	return nil
+}
+
+func (r *wayrillRemote) Close() error {
+	// Cancellation precedes the lifecycle lock, releasing queued and active RPCs
+	// even if Start is still waiting for its readiness response.
+	r.cancel()
+	r.lifecycle.Lock()
+	defer r.lifecycle.Unlock()
+	if r.conn != nil {
+		r.conn.Close()
+		r.conn = nil
+	}
+	return r.FakeDNSEngineRev0.Close()
+}
+
+func (r *wayrillRemote) call(ctx context.Context, operation string, invoke func(context.Context, command.FakeDNSServiceClient) error) (err error) {
+	defer func(caller context.Context) {
+		if caller.Err() == nil {
+			r.reportFailure(operation, err)
+		}
+	}(ctx)
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	// AfterFunc cancellation is asynchronous, even for an ended lifetime.
+	// Reject new requests before admission so they cannot reach the authority.
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	client := r.client.Load()
+	if client == nil {
+		return fmt.Errorf("shared FakeDNS is not started")
+	}
+	// Admission and execution share one deadline. Bursts wait instead of being
+	// silently converted into unknown mappings; active calls remain bounded.
+	ctx, cancel := context.WithTimeout(ctx, wayrillDeadline)
+	defer cancel()
+	stop := context.AfterFunc(r.ctx, cancel)
+	defer stop()
+	select {
+	case r.slots <- struct{}{}:
+		defer func() { <-r.slots }()
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	return invoke(ctx, client)
+}
+
+func (r *wayrillRemote) reportFailure(operation string, err error) {
+	if err == nil || r.ctx.Err() != nil {
+		return
+	}
+	r.failures.Add(1)
+	now, previous := time.Now().UnixNano(), r.reported.Load()
+	if now-previous >= int64(5*time.Second) && r.reported.CompareAndSwap(previous, now) {
+		// Never include credentials or domains. Unknown mappings are successful RPCs.
+		errors.LogWarning(r.ctx, "Shared FakeDNS gRPC ", operation, " failed (", status.Code(err), "; ", r.failures.Swap(0), " failures since last report).")
+	}
+}
+
+func (r *wayrillRemote) GetFakeIPForDomain(domain string) []net.Address {
+	return r.GetFakeIPForDomain3(domain, true, true)
+}
+func (r *wayrillRemote) GetFakeIPForDomain3(domain string, ipv4, ipv6 bool) []net.Address {
+	ips, _ := r.Allocate(r.ctx, domain, ipv4, ipv6)
+	return ips
+}
+
+func (r *wayrillRemote) Allocate(ctx context.Context, domain string, ipv4, ipv6 bool) ([]net.Address, error) {
+	if !wayrillDomain(domain) || !ipv4 && !ipv6 {
+		return nil, fmt.Errorf("invalid FakeDNS allocation request")
+	}
+	var result []net.Address
+	err := r.call(ctx, "allocate", func(ctx context.Context, client command.FakeDNSServiceClient) error {
+		response, err := client.Allocate(ctx, &command.AllocateRequest{Domain: domain, Ipv4: ipv4, Ipv6: ipv6})
+		if err != nil {
+			return err
+		}
+		for _, raw := range response.Ips {
+			if len(raw) != 4 && len(raw) != 16 {
+				return fmt.Errorf("invalid shared FakeDNS address")
+			}
+			ip := net.IPAddress(raw)
+			if !r.IsIPInIPPool(ip) || ip.Family().IsIPv4() && !ipv4 || ip.Family().IsIPv6() && !ipv6 {
+				return fmt.Errorf("shared FakeDNS address outside requested pools or families")
+			}
+			result = append(result, ip)
+		}
+		if len(result) == 0 {
+			return fmt.Errorf("shared FakeDNS returned no addresses")
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+func (r *wayrillRemote) GetDomainFromFakeDNS(ip net.Address) string {
+	domain, _ := r.ReverseLookup(r.ctx, ip)
+	return domain
+}
+
+func (r *wayrillRemote) ReverseLookup(ctx context.Context, ip net.Address) (string, error) {
+	if ip == nil || !r.IsIPInIPPool(ip) {
+		return "", nil
+	}
+	var domain string
+	err := r.call(ctx, "reverse", func(ctx context.Context, client command.FakeDNSServiceClient) error {
+		response, err := client.ReverseLookup(ctx, &command.ReverseLookupRequest{Ip: ip.IP()})
+		if err != nil {
+			return err
+		}
+		domain = response.Domain
+		if domain != "" && !wayrillDomain(domain) {
+			return fmt.Errorf("invalid shared FakeDNS domain")
+		}
+		return nil
+	})
+	if err != nil {
+		return "", err
+	}
+	return domain, nil
+}
+
+func wayrillPools(engine dns.FakeDNSEngineRev0) []string {
+	switch e := engine.(type) {
+	case *Holder:
+		return []string{e.ipRange.String()}
+	case *HolderMulti:
+		var pools []string
+		for _, holder := range e.holders {
+			pools = append(pools, holder.ipRange.String())
+		}
+		return pools
+	}
+	return nil
+}
+
+type wayrillMappingService struct {
+	command.UnimplementedFakeDNSServiceServer
+	engine dns.FakeDNSEngineRev0
+	pools  []string
+}
+
+func (s *wayrillMappingService) GetPools(context.Context, *command.GetPoolsRequest) (*command.GetPoolsResponse, error) {
+	response := &command.GetPoolsResponse{IpPools: s.pools}
+	if engine, ok := s.engine.(dns.FakeDNSStatsProvider); ok {
+		for _, pool := range engine.GetFakeDNSStats() {
+			response.Usage = append(response.Usage, &command.PoolUsage{IpPool: pool.IPPool, Used: pool.Used, Capacity: pool.Capacity})
+		}
+	}
+	return response, nil
+}
+func (s *wayrillMappingService) Allocate(ctx context.Context, request *command.AllocateRequest) (*command.AllocateResponse, error) {
+	if !wayrillDomain(request.Domain) || !request.Ipv4 && !request.Ipv6 {
+		return nil, status.Error(codes.InvalidArgument, "invalid domain or address families")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, status.FromContextError(err).Err()
+	}
+	response := &command.AllocateResponse{}
+	for _, ip := range s.engine.GetFakeIPForDomain3(request.Domain, request.Ipv4, request.Ipv6) {
+		response.Ips = append(response.Ips, ip.IP())
+	}
+	if len(response.Ips) == 0 {
+		return nil, status.Error(codes.FailedPrecondition, "no pool for requested families")
+	}
+	return response, nil
+}
+func (s *wayrillMappingService) ReverseLookup(ctx context.Context, request *command.ReverseLookupRequest) (*command.ReverseLookupResponse, error) {
+	if len(request.Ip) != 4 && len(request.Ip) != 16 {
+		return nil, status.Error(codes.InvalidArgument, "invalid IP address")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, status.FromContextError(err).Err()
+	}
+	return &command.ReverseLookupResponse{Domain: s.engine.GetDomainFromFakeDNS(net.IPAddress(request.Ip))}, nil
+}
+
+// WayrillServe keeps the upstream HolderMulti authoritative: no replicas, reverse
+// caches or additional allocation/eviction rules.
+func WayrillServe(listener stdnet.Listener, secret string, engine dns.FakeDNSEngineRev0) error {
+	if _, _, err := wayrillEndpoint(listener.Addr().String() + ":" + secret); err != nil {
+		return err
+	}
+	slots := make(chan struct{}, 32)
+	server := grpc.NewServer(grpc.MaxConcurrentStreams(32), grpc.MaxHeaderListSize(4096), grpc.KeepaliveParams(keepalive.ServerParameters{MaxConnectionIdle: time.Minute}), grpc.MaxRecvMsgSize(2048), grpc.MaxSendMsgSize(wayrillFrame),
+		grpc.ConnectionTimeout(wayrillDeadline), grpc.UnaryInterceptor(func(ctx context.Context, request any, _ *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+			p, ok := peer.FromContext(ctx)
+			if !ok {
+				return nil, status.Error(codes.PermissionDenied, "loopback connection required")
+			}
+			local, l := p.LocalAddr.(*stdnet.TCPAddr)
+			remote, r := p.Addr.(*stdnet.TCPAddr)
+			if !l || !r || !local.IP.IsLoopback() || !remote.IP.IsLoopback() {
+				return nil, status.Error(codes.PermissionDenied, "loopback connection required")
+			}
+			m, _ := metadata.FromIncomingContext(ctx)
+			credentials := m.Get(wayrillAuthHeader)
+			if len(credentials) != 1 || subtle.ConstantTimeCompare([]byte(credentials[0]), []byte(secret)) != 1 {
+				return nil, status.Error(codes.Unauthenticated, "invalid FakeDNS credential")
+			}
+			ctx, cancel := context.WithTimeout(ctx, wayrillDeadline)
+			defer cancel()
+			select {
+			case slots <- struct{}{}:
+				defer func() { <-slots }()
+			case <-ctx.Done():
+				return nil, status.FromContextError(ctx.Err()).Err()
+			}
+			return handler(ctx, request)
+		}))
+	defer server.Stop()
+	command.RegisterFakeDNSServiceServer(server, &wayrillMappingService{engine: engine, pools: wayrillPools(engine)})
+	return server.Serve(netutil.LimitListener(listener, 64))
+}
diff --git a/app/dns/fakedns/wayrill_shared_test.go b/app/dns/fakedns/wayrill_shared_test.go
new file mode 100644
index 00000000..b9e77677
--- /dev/null
+++ b/app/dns/fakedns/wayrill_shared_test.go
@@ -0,0 +1,298 @@
+package fakedns
+
+import (
+	"context"
+	"errors"
+	"github.com/xtls/xray-core/app/dns/fakedns/command"
