+++ b/common/cache/wayrill_usage.go
@@ -0,0 +1,9 @@
+package cache
+
+// Usage snapshots occupancy without touching recency or enumerating entries.
+// It is optional on Lru so existing implementations keep their interface.
+func (l *lru) Usage() (used, capacity int) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.doubleLinkedlist.Len(), l.capacity
+}
