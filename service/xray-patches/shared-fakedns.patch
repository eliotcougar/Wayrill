@@ -0,0 +1,75 @@
+package dns
+
+import (
+	"context"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	fdns "github.com/xtls/xray-core/features/dns"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+type wayrillSharedTTLServer struct {
+	cache *CacheController
+	ttl   uint32
+	sends atomic.Int32
+}
+
+func (s *wayrillSharedTTLServer) getCacheController() *CacheController { return s.cache }
+func (s *wayrillSharedTTLServer) sendQuery(_ context.Context, _ chan<- error, fqdn string, option fdns.IPOption) {
+	for _, family := range []struct {
+		enabled bool
+		typ     dnsmessage.Type
+		ip      string
+	}{
+		{option.IPv4Enable, dnsmessage.TypeA, "192.0.2.1"},
+		{option.IPv6Enable, dnsmessage.TypeAAAA, "2001:db8::1"},
+	} {
+		if family.enabled {
+			s.sends.Add(1)
+			s.cache.updateRecord(&dnsRequest{reqType: family.typ, domain: fqdn, start: time.Now()},
+				&IPRecord{IP: []net.IP{net.ParseIP(family.ip)}, Expire: time.Now().Add(time.Duration(s.ttl) * time.Second)})
+		}
+	}
+}
+
+func TestSharedQueryTTLSemantics(t *testing.T) {
+	for _, sourceTTL := range []uint32{0, 60, 300, 3600} {
+		for _, disableCache := range []bool{true, false} {
+			for _, option := range []fdns.IPOption{{IPv4Enable: true}, {IPv6Enable: true}, {IPv4Enable: true, IPv6Enable: true}} {
+				t.Run(fmt.Sprintf("ttl%d-cacheDisabled%t-v4%t-v6%t", sourceTTL, disableCache, option.IPv4Enable, option.IPv6Enable), func(t *testing.T) {
+					s := &wayrillSharedTTLServer{cache: NewCacheController("ttl-review", disableCache, false, 0), ttl: sourceTTL}
+					t.Cleanup(s.cache.requestGroup.close)
+					t.Cleanup(func() { s.cache.cacheCleanup.Close() })
+					wantIPs := 1
+					wantTTL := sourceTTL
+					if wantTTL == 0 {
+						wantTTL = 1
+					}
+					if option.IPv4Enable && option.IPv6Enable {
+						wantIPs = 2
+						wantTTL = min(wantTTL, fdns.DefaultTTL)
+					}
+					for request := 0; request < 2; request++ {
+						ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+						ips, ttl, err := queryIP(ctx, s, "ttl-review.example", option)
+						cancel()
+						if err != nil || len(ips) != wantIPs || ttl != wantTTL {
+							t.Fatalf("request %d: ips=%v ttl=%d err=%v; want %d addresses ttl=%d", request, ips, ttl, err, wantIPs, wantTTL)
+						}
+					}
+					wantSends := wantIPs
+					if disableCache || sourceTTL == 0 {
+						wantSends *= 2
+					}
+					if got := s.sends.Load(); got != int32(wantSends) {
+						t.Fatalf("sent %d wire questions, want %d", got, wantSends)
+					}
+				})
+			}
+		}
+	}
+}
