+	h.calls++
+}
+
+func TestReverseMissAllowsLoggingStats(t *testing.T) {
+	// Isolate the process-wide log handler and bound a deadlock regression.
+	const child = "XRAY_TEST_FAKEDNS_LOG_STATS"
+	if os.Getenv(child) != "1" {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestReverseMissAllowsLoggingStats$", "-test.timeout=5s")
+		cmd.Env = append(os.Environ(), child+"=1")
+		if output, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("logging statistics blocked reverse lookup: %v\n%s", err, output)
+		}
+		return
+	}
+	h, err := NewFakeDNSHolderConfigOnly(&FakeDnsPool{IpPool: "198.18.0.0/24", LruSize: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := h.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer h.Close()
+	logger := &statsLogHandler{holder: h}
+	log.RegisterHandler(logger)
+	if got := h.GetDomainFromFakeDNS(net.ParseAddress("198.18.0.1")); got != "" {
+		t.Fatal(got)
+	}
+	if logger.calls != 1 {
+		t.Fatalf("log callback count = %d", logger.calls)
+	}
+}
