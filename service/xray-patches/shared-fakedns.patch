+package fakedns
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/app/dns/fakedns/command"
+)
+
+func TestWayrillMappingOccupancy(t *testing.T) {
+	engine, err := NewFakeDNSHolderMulti(&FakeDnsPoolMulti{Pools: []*FakeDnsPool{
+		{IpPool: "198.18.0.0/28", LruSize: 3},
+		{IpPool: "2001:2::/124", LruSize: 5},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := engine.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer engine.Close()
+	service := &wayrillMappingService{engine: engine, pools: wayrillPools(engine)}
+	check := func(want4, want6 uint64) {
+		t.Helper()
+		reply, err := service.GetPools(context.Background(), &command.GetPoolsRequest{})
+		if err != nil || len(reply.Usage) != 2 {
+			t.Fatalf("usage: %v %v", reply, err)
+		}
+		if reply.Usage[0].Used != want4 || reply.Usage[0].Capacity != 3 || reply.Usage[1].Used != want6 || reply.Usage[1].Capacity != 5 {
+			t.Fatalf("unexpected occupancy: %v", reply.Usage)
+		}
+	}
+	check(0, 0)
+	ip := engine.GetFakeIPForDomain3("one.example", true, true)
+	check(1, 1)
+	engine.GetFakeIPForDomain3("one.example", true, true)
+	engine.GetDomainFromFakeDNS(ip[0])
+	check(1, 1)
+	engine.GetFakeIPForDomain3("v4.example", true, false)
+	check(2, 1)
+	// Concurrent allocation, reverse lookup and telemetry must stay bounded.
+	var workers sync.WaitGroup
+	for w := 0; w < 8; w++ {
+		workers.Add(1)
+		go func(w int) {
+			defer workers.Done()
+			for i := 0; i < 100; i++ {
+				ips := engine.GetFakeIPForDomain3(fmt.Sprintf("host-%d-%d.example", w, i), true, true)
+				engine.GetDomainFromFakeDNS(ips[0])
+				_, _ = service.GetPools(context.Background(), &command.GetPoolsRequest{})
+			}
+		}(w)
+	}
+	workers.Wait()
+	check(3, 5)
+}
