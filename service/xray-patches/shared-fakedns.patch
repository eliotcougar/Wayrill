diff --git a/app/dns/fakedns/address_width_test.go b/app/dns/fakedns/address_width_test.go
new file mode 100644
index 00000000..b0aa59ff
--- /dev/null
+++ b/app/dns/fakedns/address_width_test.go
@@ -0,0 +1,36 @@
+package fakedns
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+func TestAllocationPreservesAddressWidth(t *testing.T) {
+	for _, pool := range []string{"0.1.0.0/16", "::100:0/112"} {
+		t.Run(pool, func(t *testing.T) {
+			h, err := NewFakeDNSHolderConfigOnly(&FakeDnsPool{IpPool: pool, LruSize: 32})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := h.Start(); err != nil {
+				t.Fatal(err)
+			}
+			_, prefix, _ := net.ParseCIDR(pool)
+			for i := 0; i < 64; i++ {
+				domain := fmt.Sprintf("width-%d.example", i)
+				ips := h.GetFakeIPForDomain(domain)
+				if len(ips) != 1 || ips[0] == nil || !ips[0].Family().IsIP() || !prefix.Contains(ips[0].IP()) {
+					t.Fatalf("allocation outside %s: %v", pool, ips)
+				}
+				if got := h.GetDomainFromFakeDNS(ips[0]); got != domain {
+					t.Fatalf("reverse = %q", got)
+				}
+				if got := h.GetFakeIPForDomain(domain); len(got) != 1 || got[0] != ips[0] {
+					t.Fatal("unstable allocation")
+				}
+			}
+		})
+	}
+}
