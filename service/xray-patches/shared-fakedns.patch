+package dns
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	fdns "github.com/xtls/xray-core/features/dns"
+)
+
+type wayrillSharedWaitingServer struct {
+	cache   *CacheController
+	started chan struct{}
+}
+
+func (s *wayrillSharedWaitingServer) getCacheController() *CacheController { return s.cache }
+func (s *wayrillSharedWaitingServer) sendQuery(context.Context, chan<- error, string, fdns.IPOption) {
+	s.started <- struct{}{}
+}
+
+func TestWayrillSharedDNSWaiterCancellation(t *testing.T) {
+	source := &wayrillSharedWaitingServer{
+		cache: NewCacheController("waiting", false, false, 0), started: make(chan struct{}, 2),
+	}
+	option := fdns.IPOption{IPv4Enable: true}
+	leader, cancelLeader := context.WithCancel(context.Background())
+	defer cancelLeader()
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		fetch(leader, source, "shared.example.", option)
+	}()
+	select {
+	case <-source.started:
+	case <-time.After(time.Second):
+		t.Fatal("shared upstream query did not start")
+	}
+	defer func() {
+		cancelLeader()
+		select {
+		case <-finished:
+		case <-time.After(time.Second):
+			t.Error("shared upstream query did not drain")
+		}
+	}()
+	// Another legitimate DNS client can own a longer-running query. A native
+	// bridge waiter must still release its own slot when its deadline expires.
+	waiter, cancelWaiter := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancelWaiter()
+	done := make(chan error, 1)
+	go func() { _, _, err := fetch(waiter, source, "shared.example.", option); done <- err }()
+	<-waiter.Done()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("waiter error: %v", err)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("cancelled DNS waiter remained blocked on another client's query")
+	}
+	select {
+	case <-finished:
+		t.Fatal("cancelling a waiter stopped another client's upstream query")
+	default:
+	}
+	select {
+	case <-source.started:
+		t.Fatal("waiter duplicated the shared upstream query")
+	default:
+	}
+}
