index 00000000..0e2ad13c
--- /dev/null
+++ b/app/dns/wayrill_context_test.go
@@ -0,0 +1,81 @@
+package dns
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common/net"
+	fdns "github.com/xtls/xray-core/features/dns"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+type wayrillContextKey struct{}
+type wayrillWaitingServer struct {
+	started, drained chan struct{}
+	value            any
+}
+
+func (*wayrillWaitingServer) Name() string         { return "waiting" }
+func (*wayrillWaitingServer) IsDisableCache() bool { return true }
+func (s *wayrillWaitingServer) QueryIP(ctx context.Context, _ string, _ fdns.IPOption) ([]net.IP, uint32, error) {
+	s.value = ctx.Value(wayrillContextKey{})
+	close(s.started)
+	<-ctx.Done()
+	close(s.drained)
+	return nil, 0, ctx.Err()
+}
+
+func TestWayrillNativeLookupCancellation(t *testing.T) {
+	for _, mode := range []string{"serial", "parallel", "script"} {
+		t.Run(mode, func(t *testing.T) {
+			source := &wayrillWaitingServer{started: make(chan struct{}), drained: make(chan struct{})}
+			option := fdns.IPOption{IPv4Enable: true}
+			original := context.WithValue(context.Background(), wayrillContextKey{}, "native-scope")
+			server := &DNS{ctx: original, ipOption: &option, clients: []*Client{{server: source, ipOption: &option, timeoutMs: time.Minute}}}
+			server.hosts, _ = NewStaticHosts(nil)
+			server.enableParallelQuery = mode == "parallel"
+			if mode == "script" {
+				file := filepath.Join(t.TempDir(), "query.lua")
+				if err := os.WriteFile(file, []byte(`local s=require("xray.dns").Servers[1]; function HandleDNSQuery(d,v4,v6,f) return s:Query(d,v4,v6,f) end`), 0600); err != nil {
+					t.Fatal(err)
+				}
+				engine, err := newScriptEngine(file)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err = engine.start(server); err != nil {
+					t.Fatal(err)
+				}
+				defer engine.close()
+				server.script = engine
+			}
+			ctx, cancel := context.WithCancel(context.WithValue(context.Background(), wayrillContextKey{}, "caller-must-not-route-dns"))
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { _, _, err := server.LookupIPContext(ctx, "cancel.example", option); done <- err }()
+			select {
+			case <-source.started:
+			case <-time.After(time.Second):
+				t.Fatal("native query did not start")
+			}
+			cancel()
+			select {
+			case err := <-done:
+				if err == nil {
+					t.Fatal("cancelled lookup succeeded")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("native lookup outlived cancellation")
+			}
+			select {
+			case <-source.drained:
+			case <-time.After(time.Second):
+				t.Fatal("upstream query leaked")
+			}
+			if source.value != "native-scope" {
+				t.Fatal("caller changed the resolver routing context")
+			}
+		})
+	}
+}
diff --git a/app/dns/wayrill_query_group_test.go b/app/dns/wayrill_query_group_test.go
new file mode 100644
index 00000000..c5332f62
--- /dev/null
+++ b/app/dns/wayrill_query_group_test.go
@@ -0,0 +1,159 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	fdns "github.com/xtls/xray-core/features/dns"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+func querySignal(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(time.Second):
+		t.Fatal("query did not reach the expected lifecycle checkpoint")
+	}
+}
+
+func TestSharedQueryWaiterOwnership(t *testing.T) {
+	type scopeKey struct{}
+	var group queryGroup
+	first, cancelFirst := context.WithCancel(context.WithValue(context.Background(), scopeKey{}, "resolver-scope"))
+	defer cancelFirst()
+	finish := make(chan struct{})
+	var calls atomic.Int32
+	run := func(ctx context.Context) result {
+		calls.Add(1)
+		if ctx.Value(scopeKey{}) != "resolver-scope" {
+			t.Error("query lost routing context values")
+		}
+		select {
+		case <-ctx.Done():
+			return result{error: ctx.Err()}
+		case <-finish:
+			return result{ips: []net.IP{net.ParseIP("192.0.2.1")}, ttl: 60}
+		}
+	}
+	q, releaseFirst := group.join(first, "domain4", time.Second, run)
+	follower, releaseFollower := group.join(context.Background(), "domain4", time.Second, run)
+	if q != follower {
+		t.Fatal("same family was not coalesced")
+	}
+	cancelFirst()
+	if r := q.wait(first); !errors.Is(r.error, context.Canceled) {
+		t.Fatalf("first waiter did not cancel: %v", r.error)
+	}
+	releaseFirst()
+	if err := q.ctx.Err(); err != nil {
+		t.Fatal("first waiter canceled shared operation:", err)
+	}
+	close(finish)
+	querySignal(t, follower.done)
+	if r := follower.wait(context.Background()); len(r.ips) != 1 || r.error != nil || calls.Load() != 1 {
+		t.Fatalf("follower lost shared answer: %+v (%d calls)", r, calls.Load())
+	}
+	releaseFollower()
+}
+
+func TestSharedQueryRetirement(t *testing.T) {
+	for _, mode := range []string{"last-waiter", "budget", "shutdown"} {
+		t.Run(mode, func(t *testing.T) {
+			var group queryGroup
+			blockExit := make(chan struct{})
+			defer close(blockExit)
+			budget := time.Second
+			if mode == "budget" {
+				budget = 10 * time.Millisecond
+			}
+			q, release := group.join(context.Background(), "domain4", budget, func(ctx context.Context) result {
+				<-ctx.Done()
+				<-blockExit
+				return result{error: ctx.Err()}
+			})
+			if mode == "last-waiter" {
+				release()
+			} else if mode == "shutdown" {
+				group.close()
+			}
+			querySignal(t, q.ctx.Done())
+			if mode == "shutdown" {
+				release()
+				next, done := group.join(context.Background(), "domain4", time.Second, func(context.Context) result {
+					t.Error("closed group started a query")
+					return result{}
+				})
+				defer done()
+				if r := next.wait(context.Background()); !errors.Is(r.error, context.Canceled) {
+					t.Fatal(r.error)
+				}
+				return
+			}
+			nextFinish := make(chan struct{})
+			next, done := group.join(context.Background(), "domain4", time.Second, func(context.Context) result {
+				<-nextFinish
+				return result{}
+			})
+			defer done()
+			if next == q {
+				t.Fatal("retired query was reused")
+			}
+			if mode == "budget" {
+				release()
+			}
+			// Retirement of the old generation must not erase the replacement.
+			blockExit <- struct{}{}
+			querySignal(t, q.done)
+			group.Lock()
+			present := group.queries["domain4"] == next
+			group.Unlock()
+			close(nextFinish)
+			querySignal(t, next.done)
+			if !present {
+				t.Fatal("old query removed its replacement")
+			}
+		})
+	}
+}
+
+type partialQueryServer struct {
+	cache     *CacheController
+	firstIPv6 bool
+}
+
+func (s *partialQueryServer) getCacheController() *CacheController { return s.cache }
+func (s *partialQueryServer) Name() string                         { return "partial-test" }
+func (s *partialQueryServer) IsDisableCache() bool                 { return s.cache.disableCache }
+func (s *partialQueryServer) QueryIP(ctx context.Context, domain string, opt fdns.IPOption) ([]net.IP, uint32, error) {
+	return queryIP(ctx, s, domain, opt)
+}
+func (s *partialQueryServer) sendQuery(ctx context.Context, _ chan<- error, fqdn string, option fdns.IPOption) {
+	if option.IPv4Enable == option.IPv6Enable {
+		panic("shared queries must be per-family")
+	}
+	if option.IPv6Enable == s.firstIPv6 {
+		typ, ip := dnsmessage.TypeA, net.ParseIP("192.0.2.1")
+		if s.firstIPv6 {
+			typ, ip = dnsmessage.TypeAAAA, net.ParseIP("2001:db8::1")
+		}
+		s.cache.updateRecord(&dnsRequest{reqType: typ, domain: fqdn, start: time.Now()}, &IPRecord{IP: []net.IP{ip}, Expire: time.Now().Add(time.Minute)})
+	}
+}
+
+func TestSharedQueryPartialFamilyAtDeadline(t *testing.T) {
+	for _, ipv6 := range []bool{false, true} {
+		s := &partialQueryServer{cache: NewCacheController("partial-test", true, false, 0), firstIPv6: ipv6}
+		ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+		ips, ttl, err := s.QueryIP(ctx, "partial.example", fdns.IPOption{IPv4Enable: true, IPv6Enable: true})
+		cancel()
+		if err != nil || len(ips) != 1 || ttl == 0 || (ips[0].To4() == nil) != ipv6 {
+			t.Fatalf("lost completed family (IPv6=%v): %v, ttl=%d, err=%v", ipv6, ips, ttl, err)
+		}
+		s.cache.requestGroup.close()
+	}
+}
