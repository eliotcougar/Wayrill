@@ -0,0 +1,105 @@
+package fakedns
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/features/dns"
+)
+
+func TestPoolStatsFamiliesAndEviction(t *testing.T) {
+	h, err := NewFakeDNSHolderMulti(&FakeDnsPoolMulti{Pools: []*FakeDnsPool{
+		{IpPool: dns.FakeIPv4Pool, LruSize: 2}, {IpPool: dns.FakeIPv6Pool, LruSize: 2},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h.GetFakeDNSStats() != nil {
+		t.Fatal("uninitialized pools reported as usable")
+	}
+	if err := h.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer h.Close()
+	stats := h.GetFakeDNSStats()
+	if len(stats) != 2 || stats[0].Used != 0 || stats[1].Used != 0 || stats[0].Capacity != 2 || stats[1].Capacity != 2 {
+		t.Fatalf("empty pool stats: %+v", stats)
+	}
+	first := h.GetFakeIPForDomain3("first.example", true, false)[0]
+	h.GetFakeIPForDomain3("first.example", true, true)
+	stats = h.GetFakeDNSStats()
+	if stats[0].Used != 1 || stats[1].Used != 1 {
+		t.Fatalf("family mappings counted incorrectly: %+v", stats)
+	}
+	h.GetFakeIPForDomain3("second.example", true, false)
+	for i := 0; i < 20; i++ {
+		h.GetFakeDNSStats()
+	}
+	h.GetFakeIPForDomain3("third.example", true, false)
+	if got := h.GetDomainFromFakeDNS(first); got != "" {
+		t.Fatalf("statistics changed eviction order: %q", got)
+	}
+	stats = h.GetFakeDNSStats()
+	if stats[0].Used != 2 || stats[1].Used != 1 {
+		t.Fatalf("eviction changed occupied slots: %+v", stats)
+	}
+	stats[0].Used = 999
+	if h.GetFakeDNSStats()[0].Used != 2 {
+		t.Fatal("caller modified the allocator through a snapshot")
+	}
+}
+
+func TestConcurrentPoolStats(t *testing.T) {
+	h, err := NewFakeDNSHolderConfigOnly(&FakeDnsPool{IpPool: dns.FakeIPv4Pool, LruSize: 16})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 1000; i++ {
+			h.GetFakeDNSStats()
+		}
+	}()
+	if err := h.Start(); err != nil {
+		t.Fatal(err)
+	}
+	wg.Wait()
+	for worker := 0; worker < 8; worker++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			for i := 0; i < 100; i++ {
+				ips := h.GetFakeIPForDomain(fmt.Sprintf("%d-%d.example", worker, i))
+				h.GetDomainFromFakeDNS(ips[0])
+				stats := h.GetFakeDNSStats()
+				if len(stats) != 1 || stats[0].Capacity != 16 || stats[0].Used > 16 {
+					t.Errorf("invalid concurrent snapshot: %+v", stats)
+					return
+				}
+			}
+		}(worker)
+	}
+	wg.Wait()
+}
+
+func TestFailedPoolStartupHasNoStats(t *testing.T) {
+	h, err := NewFakeDNSHolderMulti(&FakeDnsPoolMulti{Pools: []*FakeDnsPool{
+		{IpPool: dns.FakeIPv4Pool, LruSize: 8}, {IpPool: "invalid", LruSize: 8},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer h.Close()
+	if err := h.Start(); err == nil {
+		t.Fatal("invalid second pool started")
+	}
+	if h.holders[0].GetFakeDNSStats() == nil {
+		t.Fatal("first pool was not initialized before the failure")
+	}
+	if stats := h.GetFakeDNSStats(); stats != nil {
+		t.Fatalf("partial initialization published stats: %+v", stats)
+	}
+}
