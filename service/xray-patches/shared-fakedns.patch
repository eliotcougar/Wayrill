@@ -0,0 +1,175 @@
+package fakedns_test
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/dispatcher"
+	native "github.com/xtls/xray-core/app/dns"
+	"github.com/xtls/xray-core/app/dns/fakedns"
+	"github.com/xtls/xray-core/app/dns/fakedns/command"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/dns"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type nativeService struct {
+	command.UnimplementedFakeDNSServiceServer
+	entered chan struct{}
+	exited  chan struct{}
+	err     error
+}
+
+func (*nativeService) GetPools(context.Context, *command.GetPoolsRequest) (*command.GetPoolsResponse, error) {
+	return &command.GetPoolsResponse{IpPools: []string{"198.18.0.0/24"}}, nil
+}
+
+func (s *nativeService) wait(ctx context.Context) error {
+	close(s.entered)
+	defer close(s.exited)
+	if s.err != nil {
+		return s.err
+	}
+	<-ctx.Done()
+	return status.FromContextError(ctx.Err()).Err()
+}
+
+func (s *nativeService) Allocate(ctx context.Context, _ *command.AllocateRequest) (*command.AllocateResponse, error) {
+	return nil, s.wait(ctx)
+}
+
+func (s *nativeService) ReverseLookup(ctx context.Context, _ *command.ReverseLookupRequest) (*command.ReverseLookupResponse, error) {
+	return nil, s.wait(ctx)
+}
+
+func nativeCall(t *testing.T, path string, backend *nativeService) func(context.Context) error {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	g := grpc.NewServer()
+	command.RegisterFakeDNSServiceServer(g, backend)
+	go g.Serve(l)
+	t.Cleanup(g.Stop)
+	t.Setenv("WAYRILL_FAKEDNS", l.Addr().String()+":"+strings.Repeat("a", 64))
+	instance, err := core.New(&core.Config{App: []*serial.TypedMessage{serial.ToTypedMessage(&fakedns.FakeDnsPoolMulti{
+		Pools: []*fakedns.FakeDnsPool{{IpPool: "198.18.0.0/24", LruSize: 4}},
+	})}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { instance.Close() })
+	if err := instance.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if path == "DNS" {
+		s := native.NewFakeDNSServer(instance.GetFeature((*dns.FakeDNSEngine)(nil)).(dns.FakeDNSEngine))
+		return func(ctx context.Context) error {
+			_, _, err := s.QueryIP(ctx, "native.example", dns.IPOption{IPv4Enable: true})
+			return err
+		}
+	}
+	return func(ctx context.Context) error {
+		// XrayKey is exported for tests; production obtains it from core context.
+		ctx = context.WithValue(ctx, core.XrayKey(1), instance)
+		ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: net.TCPDestination(net.ParseAddress("198.18.0.1"), 443)}})
+		_, err := dispatcher.NewSniffer(ctx).SniffMetadata(ctx)
+		return err
+	}
+}
+
+func TestWayrillNativeMappingCancellation(t *testing.T) {
+	for _, path := range []string{"DNS", "metadata"} {
+		for _, mode := range []string{"cancel", "deadline", "already-canceled", "backend-error"} {
+			t.Run(path+"/"+mode, func(t *testing.T) {
+				backend := &nativeService{entered: make(chan struct{}), exited: make(chan struct{})}
+				if mode == "backend-error" {
+					backend.err = status.Error(codes.Unavailable, "authority unavailable")
+				}
+				call := nativeCall(t, path, backend)
+				ctx, cancel := context.WithCancel(context.Background())
+				defer cancel()
+				if mode == "deadline" {
+					var timeoutCancel context.CancelFunc
+					ctx, timeoutCancel = context.WithTimeout(ctx, 150*time.Millisecond)
+					defer timeoutCancel()
+				}
+				if mode == "already-canceled" {
+					cancel()
+					if err := call(ctx); !errors.Is(err, context.Canceled) {
+						t.Fatal(err)
+					}
+					select {
+					case <-backend.entered:
+						t.Fatal("canceled request reached authority")
+					default:
+					}
+					return
+				}
+				done := make(chan error, 1)
+				go func() { done <- call(ctx) }()
+				select {
+				case <-backend.entered:
+				case <-time.After(time.Second):
+					t.Fatal("native request did not reach authority")
+				}
+				want := codes.DeadlineExceeded
+				if mode == "cancel" {
+					want = codes.Canceled
+					cancel()
+				} else if mode == "backend-error" {
+					want = codes.Unavailable
+				}
+				select {
+				case err := <-done:
+					if status.Code(err) != want {
+						t.Fatalf("want %v, got %v", want, err)
+					}
+				case <-time.After(time.Second):
+					t.Fatal("native adapter lost request cancellation")
+				}
+				select {
+				case <-backend.exited:
+				case <-time.After(time.Second):
+					t.Fatal("authority call was left running")
+				}
+			})
+		}
+	}
+}
+
+func TestWayrillNativeLocalEngineCompatibility(t *testing.T) {
+	instance, err := core.New(&core.Config{App: []*serial.TypedMessage{serial.ToTypedMessage(&fakedns.FakeDnsPoolMulti{
+		Pools: []*fakedns.FakeDnsPool{{IpPool: "198.18.0.0/24", LruSize: 4}},
+	})}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { instance.Close() })
+	if err := instance.Start(); err != nil {
+		t.Fatal(err)
+	}
+	engine := instance.GetFeature((*dns.FakeDNSEngine)(nil)).(dns.FakeDNSEngine)
+	if _, ok := engine.(dns.FakeDNSEngineContext); ok {
+		t.Fatal("fixture must exercise context-free local compatibility")
+	}
+	ips, ttl, err := native.NewFakeDNSServer(engine).QueryIP(context.Background(), "local.example", dns.IPOption{IPv4Enable: true})
+	if err != nil || len(ips) != 1 || ttl != 1 {
+		t.Fatalf("local allocation: %v, %d, %v", ips, ttl, err)
+	}
+	ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: net.TCPDestination(net.IPAddress(ips[0]), 443)}})
+	result, err := dispatcher.NewSniffer(ctx).SniffMetadata(ctx)
+	if err != nil || result == nil || result.Domain() != "local.example" {
+		t.Fatalf("local reverse lookup: %v, %v", result, err)
+	}
+}
