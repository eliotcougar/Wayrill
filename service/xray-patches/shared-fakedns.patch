+type countedFakeListener struct {
+	net.Listener
+	accepted atomic.Int64
+}
+
+func (l *countedFakeListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err == nil {
+		l.accepted.Add(1)
+	}
+	return c, err
+}
+func sharedTestPool(t *testing.T) (string, string) {
+	address, secret, _ := sharedCountedPool(t)
+	return address, secret
+}
+func sharedCountedPool(t *testing.T) (string, string, *countedFakeListener) {
+	t.Helper()
+	engine, err := NewFakeDNSHolderMulti(&FakeDnsPoolMulti{Pools: []*FakeDnsPool{
+		{IpPool: "198.18.0.0/29", LruSize: 2},
+		{IpPool: "2001:2::/125", LruSize: 2},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = engine.Start(); err != nil {
+		t.Fatal(err)
+	}
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	counted := &countedFakeListener{Listener: listener}
+	secret := strings.Repeat("a", 64)
+	done := make(chan error, 1)
+	go func() {
+		done <- WayrillServe(counted, secret, engine)
+	}()
+	t.Cleanup(func() {
+		listener.Close()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			t.Error("FakeDNS server did not drain")
+		}
+		engine.Close()
+	})
+	return listener.Addr().String(), secret, counted
+}
+
+func sharedTestClient(t *testing.T, address, secret string) dns.FakeDNSEngineRev0 {
+	t.Helper()
+	local, err := NewFakeDNSHolderMulti(&FakeDnsPoolMulti{Pools: []*FakeDnsPool{
+		{IpPool: "198.18.0.0/29", LruSize: 2}, {IpPool: "2001:2::/125", LruSize: 2},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("WAYRILL_FAKEDNS", address+":"+secret)
+	client, err := wayrillShared(context.Background(), local)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	return client
+}
+
+func TestWayrillSharedFakeDNSAcrossCoreLifetimes(t *testing.T) {
+	address, secret := sharedTestPool(t)
+	first := sharedTestClient(t, address, secret)
+	second := sharedTestClient(t, address, secret)
+	ips := first.GetFakeIPForDomain3("one.example", true, true)
+	if len(ips) != 2 {
+		t.Fatalf("Expected dual stack, got %v", ips)
+	}
+	for _, ip := range ips {
+		if second.GetDomainFromFakeDNS(ip) != "one.example" {
+			t.Fatal("Cross-core reverse lookup failed")
+		}
+	}
+	first.Close()
+	replacement := sharedTestClient(t, address, secret)
+	for _, ip := range ips {
+		if replacement.GetDomainFromFakeDNS(ip) != "one.example" {
+			t.Fatal("Core replacement lost shared mapping")
+		}
+	}
+	// Allocation and eviction belong to the native HolderMulti, not per-client caches.
+	second.GetFakeIPForDomain3("two.example", true, true)
+	second.GetFakeIPForDomain3("three.example", true, true)
+	for _, ip := range ips {
+		if replacement.GetDomainFromFakeDNS(ip) == "one.example" {
+			t.Fatal("An evicted mapping was retained in a client")
+		}
+	}
+	if len(second.GetFakeIPForDomain3("v4.example", true, false)) != 1 {
+		t.Fatal("IPv4 family selection failed")
+	}
+	if len(second.GetFakeIPForDomain3("v6.example", false, true)) != 1 {
+		t.Fatal("IPv6 family selection failed")
+	}
+	if second.GetDomainFromFakeDNS(xnet.ParseAddress("192.0.2.1")) != "" {
+		t.Fatal("Recovered a domain outside the pool")
+	}
+}
+
+func TestWayrillSharedFakeDNSRejectsUnauthenticatedAndMalformedRequests(t *testing.T) {
+	address, secret := sharedTestPool(t)
+	conn, err := grpc.NewClient("passthrough:///"+address, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	client := command.NewFakeDNSServiceClient(conn)
+	for _, auth := range [][]string{nil, {"wrong"}, {secret, secret}} {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		for _, credential := range auth {
+			ctx = metadata.AppendToOutgoingContext(ctx, wayrillAuthHeader, credential)
+		}
+		_, err = client.GetPools(ctx, &command.GetPoolsRequest{})
+		cancel()
+		if status.Code(err) != codes.Unauthenticated {
+			t.Fatalf("authentication: %v", err)
+		}
+	}
+	ctx, cancel := context.WithTimeout(metadata.AppendToOutgoingContext(context.Background(), wayrillAuthHeader, secret), time.Second)
+	defer cancel()
+	for _, request := range []*command.AllocateRequest{
+		{Domain: "bad.example"}, {Domain: "bad\n.example", Ipv4: true}, {Domain: strings.Repeat("a", 254), Ipv4: true},
+	} {
+		if _, err = client.Allocate(ctx, request); status.Code(err) != codes.InvalidArgument {
+			t.Fatalf("validation: %v", err)
+		}
+	}
+	if _, err = client.ReverseLookup(ctx, &command.ReverseLookupRequest{Ip: []byte{1, 2, 3}}); status.Code(err) != codes.InvalidArgument {
+		t.Fatal(err)
+	}
+	if _, err = client.Allocate(ctx, &command.AllocateRequest{Domain: strings.Repeat("a", 4096), Ipv4: true}); status.Code(err) != codes.ResourceExhausted {
+		t.Fatal(err)
+	}
+	if result, err := client.ReverseLookup(ctx, &command.ReverseLookupRequest{Ip: []byte{192, 0, 2, 1}}); err != nil || result.Domain != "" {
+		t.Fatalf("unknown is not a failure: %v %v", result, err)
+	}
+	healthy := sharedTestClient(t, address, secret)
+	if len(healthy.GetFakeIPForDomain("healthy.example")) != 2 {
+		t.Fatal("Rejected requests damaged the pool")
+	}
+}
+
+func TestWayrillSharedFakeDNSBurstReusesConnectionAndDrains(t *testing.T) {
+	address, secret, listener := sharedCountedPool(t)
+	client := sharedTestClient(t, address, secret).(*wayrillRemote)
+	var group sync.WaitGroup
+	start := make(chan struct{})
+	for i := 0; i < 256; i++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			<-start
+			if len(client.GetFakeIPForDomain3("burst.example", true, true)) != 2 {
+				t.Error("legitimate burst rejected")
+			}
+		}()
+	}
+	close(start)
+	group.Wait()
+	if listener.accepted.Load() != 1 {
+		t.Fatalf("mapping calls did not reuse one connection: %d", listener.accepted.Load())
+	}
+	if len(client.slots) != 0 {
+		t.Fatal("mapping slots leaked")
+	}
+	// All consumers share the same native LRU, and Close never closes authority.
+	ips := client.GetFakeIPForDomain("persistent.example")
+	client.Close()
+	replacement := sharedTestClient(t, address, secret)
+	for _, ip := range ips {
+		if replacement.GetDomainFromFakeDNS(ip) != "persistent.example" {
+			t.Fatal("consumer Close lost mapping")
+		}
+	}
+}
+
+func TestWayrillSharedFakeDNSEndpointValidation(t *testing.T) {
+	for _, value := range []string{"0.0.0.0:1:" + strings.Repeat("a", 64), "127.0.0.1:0:" + strings.Repeat("a", 64), "127.0.0.1:1:short", "127.0.0.1:1:" + strings.Repeat("z", 64)} {
+		if _, _, err := wayrillEndpoint(value); err == nil {
+			t.Fatal("Accepted invalid private endpoint")
+		}
+	}
+}
+
+// Block inside a real gRPC handler to exercise active stream cancellation and
+// queued callers together, independently of network timing or pool speed.
+type waitingFakeService struct {
+	command.UnimplementedFakeDNSServiceServer
+	started chan struct{}
+}
+
+func (s *waitingFakeService) GetPools(context.Context, *command.GetPoolsRequest) (*command.GetPoolsResponse, error) {
+	return &command.GetPoolsResponse{IpPools: []string{"198.18.0.0/29", "2001:2::/125"}}, nil
+}
+func (s *waitingFakeService) ReverseLookup(ctx context.Context, _ *command.ReverseLookupRequest) (*command.ReverseLookupResponse, error) {
+	s.started <- struct{}{}
+	<-ctx.Done()
+	return nil, status.FromContextError(ctx.Err()).Err()
+}
+func TestWayrillSharedFakeDNSCloseCancelsActiveAndQueued(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := grpc.NewServer()
+	defer server.Stop()
+	source := &waitingFakeService{started: make(chan struct{}, 128)}
+	command.RegisterFakeDNSServiceServer(server, source)
+	go server.Serve(listener)
+	client := sharedTestClient(t, listener.Addr().String(), strings.Repeat("a", 64)).(*wayrillRemote)
+	var group sync.WaitGroup
+	for i := 0; i < 128; i++ {
+		group.Add(1)
+		go func() { defer group.Done(); client.GetDomainFromFakeDNS(xnet.ParseAddress("198.18.0.1")) }()
+	}
+	for i := 0; i < 32; i++ {
+		select {
+		case <-source.started:
+		case <-time.After(time.Second):
+			t.Fatal("active streams did not reach server")
+		}
+	}
+	began := time.Now()
+	client.Close()
+	done := make(chan struct{})
+	go func() { group.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("Close retained active or queued callers")
+	}
+	if len(client.slots) != 0 || time.Since(began) > time.Second {
+		t.Fatal("Close did not drain admission")
+	}
+	if err := client.Start(); err == nil {
+		t.Fatal("closed consumer restarted")
+	}
+}
+
+func TestWayrillSharedFakeDNSStartFailureAndClose(t *testing.T) {
+	address, secret := sharedTestPool(t)
+	t.Setenv("WAYRILL_FAKEDNS", address+":"+strings.Repeat("b", 64))
+	local, _ := NewFakeDNSHolderMulti(&FakeDnsPoolMulti{Pools: []*FakeDnsPool{{IpPool: "198.18.0.0/29", LruSize: 2}}})
+	object, err := wayrillShared(context.Background(), local)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := object.(*wayrillRemote)
+	if err := client.Start(); status.Code(errors.Unwrap(err)) != codes.Unauthenticated {
+		t.Fatalf("wrong credential: %v", err)
+	}
+	if client.conn != nil || client.client.Load() != nil {
+		t.Fatal("failed Start published a connection")
+	}
+	client.Close()
+	// A valid credential still cannot attach a mismatched pool configuration.
+	t.Setenv("WAYRILL_FAKEDNS", address+":"+secret)
+	object, err = wayrillShared(context.Background(), local)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer object.Close()
+	if err = object.Start(); err == nil {
+		t.Fatal("mismatched pool geometry accepted")
+	}
+}
